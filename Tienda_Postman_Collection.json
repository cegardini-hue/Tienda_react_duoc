{
  "info": {
    "_postman_id": "51b80690-e98c-4c98-9c64-13e2d31cf83c",
    "name": "Tienda React Duoc - API v1",
    "description": "Colección para login, catálogo, administración de productos y boletas. Completa baseUrl, adminEmail y adminPassword; no se incluyen secretos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081/api" },
    { "key": "adminEmail", "value": "" },
    { "key": "adminPassword", "value": "" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "JM001" },
    { "key": "boletaId", "value": "1" }
  ],
  "item": [
    {
      "name": "Autenticación",
      "item": [
        {
          "name": "Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login exitoso y token disponible', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accessToken).to.be.a('string').and.not.empty;",
                  "  pm.collectionVariables.set('accessToken', body.accessToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/auth/login"
          }
        },
        {
          "name": "Registrar cliente de prueba",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Postman\",\n  \"email\": \"cliente.prueba@ejemplo.cl\",\n  \"fechaNacimiento\": \"2000-01-01\",\n  \"password\": \"cambia-esta-clave-123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/auth/register"
          }
        }
      ]
    },
    {
      "name": "Catálogo",
      "item": [
        {
          "name": "Listar productos",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/productos"
          }
        },
        {
          "name": "Listar categorías",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/v1/categorias"
          }
        },
        {
          "name": "Crear producto (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto Postman\",\n  \"precio\": 1000,\n  \"categoria\": \"Pruebas\",\n  \"descripcion\": \"Producto creado para probar la API\",\n  \"imagen\": \"https://example.com/producto.png\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/productos"
          }
        },
        {
          "name": "Editar producto (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Producto actualizado\",\n  \"precio\": 1500,\n  \"categoria\": \"Pruebas\",\n  \"descripcion\": \"Producto editado con Postman\",\n  \"imagen\": \"https://example.com/producto.png\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/productos/{{productId}}"
          }
        },
        {
          "name": "Eliminar producto (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/v1/productos/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Boletas",
      "item": [
        {
          "name": "Crear boleta (CLIENTE o ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreEntrega\": \"Cliente de prueba\",\n  \"correoEntrega\": \"entrega@ejemplo.cl\",\n  \"direccion\": \"Av. Ejemplo 123\",\n  \"productos\": [\n    { \"productoId\": \"JM001\", \"cantidad\": 1 }\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/v1/boletas"
          }
        },
        {
          "name": "Listar boletas (ADMIN o VENDEDOR)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/v1/boletas"
          }
        },
        {
          "name": "Detalle de boleta (ADMIN o VENDEDOR)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/v1/boletas/{{boletaId}}"
          }
        }
      ]
    }
  ]
}
