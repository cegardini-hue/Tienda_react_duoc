[Unit]
Description=Tienda React API
After=network.target

[Service]
Type=simple
User=tienda
Group=tienda
WorkingDirectory=/var/lib/tienda-api
EnvironmentFile=/etc/tienda-api.env
Environment=SPRING_PROFILES_ACTIVE=prod
ExecStart=/usr/bin/java -jar /opt/tienda-api/tienda-api.jar
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/tienda-api
UMask=0077

[Install]
WantedBy=multi-user.target
